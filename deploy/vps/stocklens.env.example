# /etc/stocklens/stocklens.env - secrets and settings for the VPS scheduler.
# Owner root, group stocklens, mode 0640 (setup.sh). Edit on the server only
# (sudo nano /etc/stocklens/stocklens.env); never commit or paste the values.

# The StockLens API (Render)
STOCKLENS_API_URL=https://stocklens-api-otrc.onrender.com

# This server's own scheduler token: written by deploy/vps/make-token.sh,
# which prints only its SHA-256 digest (add that digest to Render's
# SCHEDULER_TOKEN_SHA256, comma-separated after the existing one).
STOCKLENS_SCHEDULER_TOKEN=

# Render PostgreSQL "External Database URL" (Render -> your database -> Connect).
# Needed only by the daily ranking.
DATABASE_URL=

# Same engine settings as GitHub Actions / Render
APP_ENV=production
ENGINE_RUN_ALLOW_ML=false
ENGINE_RUN_MAX_WORKERS=2
PYTHONUNBUFFERED=1
